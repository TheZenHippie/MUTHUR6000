<Window x:Class="MUTHUR6000.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MUTHUR 6000 // WEYLAND-YUTANI CORP"
        Icon="icon.png"
        Height="540" Width="820"
        MinHeight="220" MinWidth="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeChanged="Window_SizeChanged"
        ContextMenuOpening="Window_ContextMenuOpening">

    <Window.ContextMenu>
        <ContextMenu x:Name="MainContextMenu"
                     PreviewMouseMove="MainContextMenu_PreviewMouseMove"
                     PreviewMouseLeftButtonDown="MainContextMenu_PreviewMouseLeftButtonDown"
                     Closed="MainContextMenu_Closed">

            <!-- Baud Rate Selection -->
            <MenuItem x:Name="BaudRateMenuItem" Header="Baud Rate (Typing Speed)">
                <MenuItem Header="300 Baud (Slow Vintage)" Click="BaudRate_Click" Tag="300"/>
                <MenuItem Header="600 Baud (Standard Telecom)" Click="BaudRate_Click" Tag="600"/>
                <MenuItem Header="1200 Baud (MUTHUR Default)" Click="BaudRate_Click" Tag="1200" IsChecked="True"/>
                <MenuItem Header="2400 Baud (High-Speed)" Click="BaudRate_Click" Tag="2400"/>
                <MenuItem Header="4800 Baud (Fast Serial)" Click="BaudRate_Click" Tag="4800"/>
                <MenuItem Header="9600 Baud (Instant Feed)" Click="BaudRate_Click" Tag="9600"/>
            </MenuItem>

            <!-- Playback Controls -->
            <MenuItem x:Name="PauseResumeMenuItem" Header="Pause Transmission" Click="PauseResume_Click"/>
            <MenuItem Header="Skip to Next File" Click="SkipNext_Click"/>
            <MenuItem Header="Restart Boot Sequence" Click="RestartBoot_Click"/>
            <MenuItem Header="Clear Screen" Click="ClearScreen_Click"/>
            <Separator/>

            <!-- Phosphor (Text) Color Palette with Visual Swatches -->
            <MenuItem x:Name="PhosphorColorMenuItem" Header="Phosphor Color">
                <MenuItem Header="Matrix / Nostromo Green" Click="PhosphorColor_Click" Tag="#00FF66" IsChecked="True">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#00FF66" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Solar Amber (Alien Gold)" Click="PhosphorColor_Click" Tag="#FFB000">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FFB000" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Nostromo Cyan" Click="PhosphorColor_Click" Tag="#00F0FF">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#00F0FF" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Phosphor White" Click="PhosphorColor_Click" Tag="#F0F0F0">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#F0F0F0" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Glitch Red" Click="PhosphorColor_Click" Tag="#FF2244">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FF2244" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Night City Violet" Click="PhosphorColor_Click" Tag="#A040FF">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#A040FF" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Synthwave Magenta" Click="PhosphorColor_Click" Tag="#FF007F">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FF007F" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Custom Phosphor Color..." Click="CustomPhosphorColor_Click"/>
            </MenuItem>

            <!-- Background Color Palette with Visual Swatches -->
            <MenuItem x:Name="BackgroundColorMenuItem" Header="Background Color">
                <MenuItem Header="Tinted CRT Dark Green" Click="BackgroundColor_Click" Tag="#08140B" IsChecked="True">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#08140B" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Pitch Black (Void)" Click="BackgroundColor_Click" Tag="#000000">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#000000" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Dark Charcoal" Click="BackgroundColor_Click" Tag="#0E1116">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#0E1116" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Deep Amber Dark" Click="BackgroundColor_Click" Tag="#140B04">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#140B04" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Deep Space Navy" Click="BackgroundColor_Click" Tag="#040812">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#040812" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Custom Background Color..." Click="CustomBackgroundColor_Click"/>
            </MenuItem>
            <Separator/>

            <!-- Background Opacity Slider (0% - 100%) -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="210" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Background Opacity" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BackgroundOpacityValueText" Text="85%" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="BackgroundOpacitySlider"
                                Minimum="0.0" Maximum="1.0" Value="0.85"
                                SmallChange="0.05" LargeChange="0.1"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <!-- Phosphor Text Opacity Slider (10% - 100%) -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="210" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Phosphor Text Opacity" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FontOpacityValueText" Text="100%" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="FontOpacitySlider"
                                Minimum="0.1" Maximum="1.0" Value="1.0"
                                SmallChange="0.05" LargeChange="0.1"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="FontOpacitySlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator/>

            <!-- Font Family -->
            <MenuItem x:Name="FontFamilyMenuItem" Header="Font Family">
                <MenuItem Header="Choose Font (All System Fonts)..." Click="ChooseAllFonts_Click" FontWeight="Bold"/>
                <Separator/>
                <!-- Monospace favorites dynamically populated and checked in code-behind -->
            </MenuItem>

            <!-- Font Size -->
            <MenuItem x:Name="FontSizeMenuItem" Header="Font Size">
                <MenuItem Header="10 pt" Click="FontSize_Click" Tag="10"/>
                <MenuItem Header="11 pt" Click="FontSize_Click" Tag="11"/>
                <MenuItem Header="12 pt" Click="FontSize_Click" Tag="12"/>
                <MenuItem Header="13 pt" Click="FontSize_Click" Tag="13" IsChecked="True"/>
                <MenuItem Header="14 pt" Click="FontSize_Click" Tag="14"/>
                <MenuItem Header="16 pt" Click="FontSize_Click" Tag="16"/>
                <MenuItem Header="18 pt" Click="FontSize_Click" Tag="18"/>
                <MenuItem Header="20 pt" Click="FontSize_Click" Tag="20"/>
                <MenuItem Header="24 pt" Click="FontSize_Click" Tag="24"/>
            </MenuItem>
            <Separator/>

            <!-- Visual Effects Suite -->
            <MenuItem x:Name="EffectsMenuItem"
                      Header="Effects"
                      StaysOpenOnClick="True"
                      MouseEnter="EffectsMenuItem_MouseEnter"
                      MouseLeave="EffectsMenuItem_MouseLeave"
                      SubmenuOpened="EffectsMenuItem_SubmenuOpened"
                      SubmenuClosed="EffectsMenuItem_SubmenuClosed">

                <!-- Phosphor Bloom Glow -->
                <MenuItem x:Name="BloomGlowMenuItem"
                          Header="Phosphor Bloom Glow"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="BloomGlow_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Bloom Amount" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BloomIntensityValueText" Text="8px" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="BloomIntensitySlider"
                                    Minimum="0" Maximum="25" Value="8"
                                    SmallChange="1" LargeChange="3"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="BloomIntensitySlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>

                <!-- Vintage CRT Scanlines -->
                <MenuItem x:Name="CrtScanlinesMenuItem"
                          Header="Vintage CRT Scanlines"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="CrtScanlines_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Scanline Thickness" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ScanlineThicknessValueText" Text="3px" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="ScanlineThicknessSlider"
                                    Minimum="1" Maximum="20" Value="3"
                                    SmallChange="1" LargeChange="2"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="ScanlineThicknessSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>

                <!-- Monochrome CRT Glitch -->
                <MenuItem x:Name="CrtGlitchMenuItem"
                          Header="Monochrome CRT Glitch"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="CrtGlitch_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Glitch Intensity" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GlitchChanceValueText" Text="15%" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="GlitchChanceSlider"
                                    Minimum="0" Maximum="100" Value="15"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="GlitchChanceSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>

                <!-- CRT Snow Static -->
                <MenuItem x:Name="CrtSnowMenuItem"
                          Header="CRT Snow Static Noise"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="CrtSnow_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Snow Strength" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SnowAmountValueText" Text="25%" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="SnowAmountSlider"
                                    Minimum="0" Maximum="100" Value="25"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="SnowAmountSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
            <Separator/>

            <!-- Window Options -->
            <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on Top" IsCheckable="True" IsChecked="False" Click="AlwaysOnTop_Click"/>
            <MenuItem x:Name="ShadowMenuItem" Header="Window Shadow" IsCheckable="True" IsChecked="True" Click="Shadow_Click"/>
            <Separator/>
            <MenuItem Header="Close MUTHUR Console" Click="CloseWidget_Click"/>
            <MenuItem Header="Exit All" Click="ExitAll_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Background="#01000000">
        <!-- LAYER 0: CRT Glass Panel Background & Drop Shadow -->
        <Border x:Name="WindowBackgroundBorder"
                Margin="14"
                CornerRadius="8"
                BorderThickness="1.5"
                BorderBrush="#4000FF66"
                Background="#D808140B"
                Opacity="0.85">
            <Border.Effect>
                <DropShadowEffect x:Name="WindowDropShadow"
                                  BlurRadius="18"
                                  ShadowDepth="4"
                                  Direction="315"
                                  Color="Black"
                                  Opacity="0.35"
                                  RenderingBias="Performance"/>
            </Border.Effect>
        </Border>

        <!-- LAYER 1: Terminal Content Layout -->
        <Grid x:Name="TerminalContentGrid" Margin="14" Opacity="1.0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Retro Header Bar -->
                <RowDefinition Height="*"/>    <!-- Scrollable Character Terminal Stream -->
                <RowDefinition Height="Auto"/> <!-- Telemetry Status Footer -->
            </Grid.RowDefinitions>

            <!-- Draggable Retro Header Bar -->
            <Border x:Name="HeaderBarBorder"
                    Grid.Row="0"
                    Background="#15000000"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#2500FF66"
                    CornerRadius="7,7,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <!-- Left: System Identity Badge -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border x:Name="SystemBadgeBorder"
                                Background="Transparent"
                                BorderBrush="#6000FF66"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2">
                            <TextBlock x:Name="SystemBadgeText"
                                       Text="[ MUTHUR 6000 ]"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#00FF66"/>
                        </Border>
                    </StackPanel>

                    <!-- Center: Overmonitoring Matrix Boxed Badge -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="OvermonitoringBadgeBorder"
                                Background="Transparent"
                                BorderBrush="#6000FF66"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,2">
                            <TextBlock x:Name="HeaderStatusText"
                                       Text="[ OVERMONITORING MATRIX ]"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#00FF66"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Right-side Quick Action Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Baud Rate Badge Button -->
                        <Button x:Name="BaudRateButton"
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                ToolTip="Click to cycle Baud Rate"
                                Click="BaudRateBadge_Click">
                            <Border x:Name="BaudBadgeBorder"
                                    Background="Transparent"
                                    BorderBrush="#5000FF66"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="5,2">
                                <TextBlock x:Name="BaudBadgeText"
                                           Text="[ 1200 BAUD ]"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#00FF66"/>
                            </Border>
                        </Button>

                        <!-- Pause / Resume Button -->
                        <Button x:Name="PauseButton"
                                Content="PAUSE"
                                ToolTip="Pause/Resume transmission"
                                Style="{x:Null}"
                                Background="Transparent"
                                Foreground="#80FFFFFF"
                                BorderThickness="0"
                                Padding="6,2"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="PauseResume_Click"/>

                        <!-- Skip Button -->
                        <Button x:Name="SkipButton"
                                Content="SKIP"
                                ToolTip="Skip to next telemetry file"
                                Style="{x:Null}"
                                Background="Transparent"
                                Foreground="#80FFFFFF"
                                BorderThickness="0"
                                Padding="6,2"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="SkipNext_Click"/>

                        <!-- Clear Button -->
                        <Button x:Name="ClearButton"
                                Content="CLR"
                                ToolTip="Clear terminal screen"
                                Style="{x:Null}"
                                Background="Transparent"
                                Foreground="#80FFFFFF"
                                BorderThickness="0"
                                Padding="6,2"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="ClearScreen_Click"/>

                        <!-- Close Button -->
                        <Button x:Name="CloseButton"
                                Content="✕"
                                ToolTip="Close MUTHUR Console"
                                Style="{x:Null}"
                                Background="Transparent"
                                Foreground="#80FFFFFF"
                                BorderThickness="0"
                                Padding="6,2"
                                FontSize="11"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="CloseWidget_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main CRT Terminal Text Area with Phosphor Bloom -->
            <Grid Grid.Row="1" x:Name="TerminalGrid">
                <!-- Text Display Box -->
                <RichTextBox x:Name="TerminalOutputBox"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             Background="Transparent"
                             Foreground="#00FF66"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="13"
                             BorderThickness="0"
                             Padding="12,10"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             IsUndoEnabled="False"
                             CaretBrush="#00FF66">
                    <RichTextBox.Effect>
                        <DropShadowEffect x:Name="TextBloomEffect"
                                          BlurRadius="8"
                                          ShadowDepth="0"
                                          Color="#00FF66"
                                          Opacity="0.85"
                                          RenderingBias="Performance"/>
                    </RichTextBox.Effect>
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type Paragraph}">
                            <Setter Property="Margin" Value="0,0"/>
                            <Setter Property="LineHeight" Value="18"/>
                        </Style>
                        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#6000FF66"/>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
                            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Width" Value="6"/>
                            <Setter Property="MinWidth" Value="6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                                            <Rectangle Width="2" HorizontalAlignment="Center" Fill="#12FFFFFF" RadiusX="1" RadiusY="1"/>
                                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                <Track.Thumb>
                                                    <Thumb Style="{x:Null}">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border x:Name="ThumbBorder"
                                                                        Background="{DynamicResource ScrollThumbBrush}"
                                                                        CornerRadius="1.5"
                                                                        Width="3"
                                                                        HorizontalAlignment="Center"/>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="true">
                                                                        <Setter TargetName="ThumbBorder" Property="Width" Value="4"/>
                                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.9"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="true">
                                                                        <Setter TargetName="ThumbBorder" Property="Width" Value="4"/>
                                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </RichTextBox.Resources>
                    <FlowDocument x:Name="TerminalFlowDocument" PagePadding="0"/>
                </RichTextBox>
            </Grid>

            <!-- Telemetry Footer Bar -->
            <Border x:Name="FooterBarBorder"
                    Grid.Row="2"
                    Background="#15000000"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#2500FF66"
                    CornerRadius="0,0,7,7"
                    Padding="10,4">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="ActiveFileText"
                                   Text="FEED: INITIALIZING..."
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#00FF66"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="TransmissionStatusText"
                                   Text="STATUS: CONNECTED"
                                   FontSize="10"
                                   Foreground="#70FFFFFF"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="DeckStatusText"
                                   Text="PLAYLIST: 0 / 0"
                                   FontSize="10"
                                   Foreground="#60FFFFFF"
                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="HoldStatusText"
                                   Text="HOLD: 3.0s"
                                   FontSize="10"
                                   Foreground="#50FFFFFF"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Jitter Transform for Glitch FX -->
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ContentJitterTransform" X="0" Y="0"/>
            </Grid.RenderTransform>
        </Grid>

        <!-- LAYER 2: CRT Overlays (Scanlines, Snow Static, Monochrome Glitch, Beam Scan & Reverse Highlight) -->
        <Grid x:Name="CrtOverlayGrid" Margin="14" IsHitTestVisible="False">
            <!-- CRT Snow Static Noise Overlay -->
            <Image x:Name="CrtSnowOverlay"
                   Stretch="Fill"
                   Visibility="Collapsed"
                   Opacity="0.0"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <!-- Vintage CRT Scanlines -->
            <Rectangle x:Name="CrtScanlinesOverlay"
                       Visibility="Collapsed"
                       Opacity="0.85"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <DrawingBrush x:Name="CrtDrawingBrush" TileMode="Tile" Viewport="0,0,1,6" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#00000000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,6"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#F0000000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,3"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- CRT Monochrome Glitch Canvas & Right-to-Left Beam Scan -->
            <Canvas x:Name="CrtGlitchCanvas"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    ClipToBounds="True">
                <!-- Right-to-Left Horizontal Scan Beam Line -->
                <Rectangle x:Name="GlitchBeamLine"
                           Height="2"
                           Width="0"
                           Fill="#00FF66"
                           Opacity="0.0"/>

                <!-- Reverse-Video Highlight Box over targeted character -->
                <Border x:Name="GlitchReverseHighlightBox"
                        Background="#00FF66"
                        Padding="1,0"
                        CornerRadius="1"
                        Visibility="Collapsed"
                        Opacity="0.0">
                    <TextBlock x:Name="GlitchReverseHighlightText"
                               Text="A"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#08140B"/>
                </Border>
            </Canvas>
        </Grid>

        <!-- LAYER 3: Resize Grip -->
        <ResizeGrip HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Opacity="0.4"
                    Cursor="SizeNWSE"/>
    </Grid>
</Window>

